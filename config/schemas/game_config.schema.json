{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GameConfig",
  "type": "object",
  "properties": {
    "Name": { "type": "string" },
    "MovementStyle": { "enum": ["Free", "Grid", "Hex"] },
    "MeasurementUnit": { "enum": ["Inches", "Centimeters", "Pixels"] },
    "UnitsPerMeasurement": { "type": "number", "default": 1.0 },
    "Dice": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": { "type": "string" },
          "Faces": { 
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2
          }
        },
        "required": ["Name", "Faces"]
      }
    }
  },
  "required": ["Name", "MovementStyle", "MeasurementUnit"]
}
